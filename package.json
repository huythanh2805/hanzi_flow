{
  "name": "hanziflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost",
    "prebuild": "npm run data:prepare",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests docs *.ts *.mjs README.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:database": "tsx scripts/test-database.ts",
    "test:practice-database": "tsx scripts/test-practice-database.ts",
    "test:practice-cloud": "node --import tsx --env-file-if-exists=.env.local scripts/test-practice-cloud.ts",
    "test:practice-exercises-cloud": "node --import tsx --env-file-if-exists=.env.local scripts/test-practice-exercises-cloud.ts",
    "test:cloud": "node --import tsx --env-file-if-exists=.env.local scripts/test-cloud.ts",
    "data:prepare": "tsx scripts/prepare-data.ts",
    "data:import": "tsx --env-file-if-exists=.env.local scripts/import-data.ts",
    "data:enrichment": "tsx scripts/validate-enrichment.ts",
    "data:topics": "tsx scripts/classify-topics.ts",
    "data:import-topics": "tsx --env-file-if-exists=.env.local scripts/import-topics.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.89.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "opencc-js": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
